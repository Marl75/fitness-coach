rules_version = '2';
// Règles de sécurité de Routine (projet « fitcoach-71392 »).
// Ce fichier est une référence : les règles actives se règlent dans la console Firebase
// (Firestore Database > Règles), ou avec « firebase deploy --only firestore:rules ».
// La page de suivi (marl75.github.io/admin) affiche ce texte avec le bon identifiant
// à la place de ADMIN_UID.
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque compte ne lit et n'écrit que ses propres séances, exercices et réglages
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Statistiques d'utilisation : chaque compte écrit les siennes ;
    // seule l'administratrice peut toutes les lire
    match /usage/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == 'ADMIN_UID');
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }
    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
