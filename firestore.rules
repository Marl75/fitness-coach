rules_version = '2';
// Règles de sécurité de FitCoach : chaque personne connectée ne peut lire et écrire
// que ses propres séances et exercices (users/{son uid}/...). Tout le reste est refusé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
